# Copy to `.env` and fill in. Never commit `.env`.

CLIENT_ID=
CLIENT_SECRET=

# Deliverect account Mongo `_id`.
ACCOUNT_ID=

# Catalog published by Push catalog.
CATALOG_ID=

# Password required to open the app.
APP_PASSWORD=

# Optional. When set, Deliveroo Retail links must use this brand ID.
# Leave empty to accept any brand ID.
DELIVEROO_BRAND_ID=

# Optional. Notifies Zapier when Publish is clicked. Same name in Streamlit secrets.
ZAPIER_WEBHOOK_URL=
